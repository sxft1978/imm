# syntax=docker/dockerfile:1.7
# ImmortalWrt 固件根文件系统镜像
# 构建上下文 = docker_ctx/，内含 openwrt-rootfs.tar.gz
# 由工作流 Job3「Prepare Docker context」负责准备

FROM scratch

# ADD 会自动解压 tar.gz 到镜像根目录
# 前提：tar 顶层直接是 etc/ lib/ usr/ sbin/ bin/ 等（ImmortalWrt 标准 rootfs tar）
ADD openwrt-rootfs.tar.gz /

# procd 作为 PID1 入口
ENTRYPOINT ["/sbin/init"]
